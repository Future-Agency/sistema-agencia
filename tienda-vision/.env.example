# Base de datos. Por defecto SQLite local. Para Supabase usá la connection string de Postgres:
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./tienda.db

# Config de cámaras y zonas
CONFIG_PATH=./config/cameras.yaml

# Carpetas de grabaciones continuas y clips de alertas
RECORDINGS_DIR=./recordings
CLIPS_DIR=./clips

# Clave de Anthropic para la revisión de clips (opcional, sin esto /alerts/{id}/review devuelve 503)
ANTHROPIC_API_KEY=
